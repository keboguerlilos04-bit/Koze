# Copy to .env next to docker-compose.yaml and fill in the blanks.
# Never commit the real .env: it holds the database and Redis passwords.

# ---- Rails ----
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
FRONTEND_URL=https://tint-moody-venture.ngrok-free.dev
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
DEFAULT_LOCALE=en
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot_production
# postgres://<POSTGRES_USERNAME>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DATABASE>
DATABASE_URL=

# ---- Redis ----
REDIS_PASSWORD=
# redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=

# ---- Mail (optional; fill in SMTP to send emails) ----
MAILER_SENDER_EMAIL=
SMTP_DOMAIN=
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
