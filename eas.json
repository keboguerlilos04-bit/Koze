{
  "cli": {
    "version": ">= 12.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    // Installable APK for testing on a phone.
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        // Koze server on the AWS VPS (server/vps-setup.sh), instead of ngrok on the PC.
        "EXPO_PUBLIC_KOZE_SERVER_HOST": "3-150-222-58.sslip.io"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal" // (enum: production, beta, alpha, internal)
      }
    }
  }
}
